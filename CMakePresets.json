{
  "version": 6,
  "cmakeMinimumRequired": {"major": 3, "minor": 29, "patch": 0},
  "configurePresets": [
    {
      "name": "debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/.build/debug",
      "toolchainFile": "${sourceDir}/cmake/NativeToolchain.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "AMBER_SANITIZE": true
      }
    },
    {
      "name": "dev",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/.build/dev",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS_DEBUG": "-g1",
        "AMBER_SANITIZE": false
      }
    },
    {
      "name": "profile",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/.build/profile",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_FLAGS_RELEASE": "-O3 -DNDEBUG -g1 -fno-omit-frame-pointer",
        "AMBER_SANITIZE": false
      }
    }
  ],
  "buildPresets": [
    {"name": "debug", "configurePreset": "debug", "targets": ["check-binaries"]},
    {"name": "dev", "inherits": "debug", "configurePreset": "dev"},
    {"name": "profile", "configurePreset": "profile", "targets": ["amb-server"]}
  ],
  "testPresets": [
    {"name": "debug", "configurePreset": "debug", "output": {"outputOnFailure": true}},
    {"name": "dev", "inherits": "debug", "configurePreset": "dev"}
  ]
}
